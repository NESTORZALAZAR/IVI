DJANGO_SECRET_KEY=replace-with-a-long-random-secret
DJANGO_DEBUG=False
DJANGO_ALLOWED_HOSTS=ivi.example.com
CORS_ALLOWED_ORIGINS=https://ivi.example.com
CSRF_TRUSTED_ORIGINS=https://ivi.example.com

# PostgreSQL in production. SQLite is used when this is omitted.
DATABASE_URL=postgresql://user:password@host:5432/ivi

SECURE_SSL_REDIRECT=True
